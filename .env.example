# Scopus MCP — environment variable template.
# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.

# ─── Cloudflare Worker dev mode (npm run dev) ───
# Bearer tokens that gate access to the Worker's /mcp endpoint.
# Generate with: openssl rand -base64 32
OWNER_API_KEY=replace-with-openssl-rand-base64-32
TEAM_API_KEY=replace-with-openssl-rand-base64-32

# ─── Local stdio mode (npm run local) ───
# Your Elsevier Scopus API key — get one free at https://dev.elsevier.com/
SCOPUS_API_KEY=replace-with-your-scopus-api-key

# Optional: Institutional Token for off-campus IP bypass.
# Request from integrationsupport@elsevier.com if your institution requires it.
# Uncomment and fill in only if you have one.
# SCOPUS_INST_TOKEN=replace-with-your-insttoken
